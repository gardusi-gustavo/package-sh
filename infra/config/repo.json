{
  "schema": 1,
  "name": "package-sh",
  "organization": "gardusi-gustavo",
  "layer": 1,
  "kind": "template",
  "visibility": "public",
  "platforms": [
    "gitea",
    "github"
  ],
  "features": {
    "ci": true,
    "pages": false,
    "release": true,
    "observability": false
  },
  "limits": {
    "repo_mb": 100,
    "file_mb": 25,
    "max_symlinks": 0
  },
  "ci": {
    "profile": "universal",
    "script": "infra/scripts/ci.sh",
    "timeout_minutes": 15,
    "required_jobs": [
      "ci"
    ],
    "primary": "gitea"
  },
  "versioning": {
    "scheme": "semver",
    "tag_prefix": "v",
    "release_artifacts": true
  },
  "dependencies": {},
  "depends_on": [],
  "consumers": [],
  "data_classification": "public",
  "files": {
    "rules": {
      ".github/": {
        "allow_globs": [
          "*"
        ],
        "allow_names": [
          "CODEOWNERS"
        ]
      },
      ".github/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".github/ISSUE_TEMPLATE/": {
        "allow_extensions": [
          ".yml",
          ".yaml",
          ".md"
        ]
      }
    },
    "forbid": []
  }
}
